#[test(tb_transmitter_native)]
module tb_transmitter_native {
    const CLOCK_FREQUENCY: u32 = 100_000_000;
    const BAUD_RATE      : u32 = 115200;
    const WORD_WIDTH     : u32 = 8;
    const CLOCKS_PER_BIT : u32 = CLOCK_FREQUENCY / BAUD_RATE;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var din  : logic<WORD_WIDTH>;
    var empty: logic            ;
    var re   : logic            ;
    var dout : logic            ;

    inst dut: transmitter_native #(
        CLOCK_FREQUENCY: CLOCK_FREQUENCY,
        BAUD_RATE      : BAUD_RATE      ,
        WORD_WIDTH     : WORD_WIDTH     ,
    ) (
        clk    ,
        rst    ,
        din    ,
        empty  ,
        re     ,
        dout   ,
    );

    initial {
        din        = 0;
        empty      = 1;
        rst.assert();

        // state == WAIT
        din      = 8'hA5;
        empty    = 0;
        clk.next();

        // state == ASSERT_READ_ENABLE
        $assert(re == 1'b1, "assert_read_enable: re");
        $assert(dout == 1'b1, "assert_read_enable: dout");

        empty    = 1;
        clk.next();

        // state == READ_WORD
        $assert(re == 1'b0, "read_word: re");
        $assert(dout == 1'b1, "read_word: dout");

        clk.next();

        // state == TRANSMIT_BITS
        let frame: logic<WORD_WIDTH + 2> = {1'b1, din, 1'b0};
        for j in 0..(WORD_WIDTH + 2) {
            for _i in 0..CLOCKS_PER_BIT {
                $assert (re == 1'b0, "transmit_bits: re");
                $assert (dout == frame[j], "transmit_bits: dout");
                clk.next();
            }
        }

        // state == WAIT
        $assert(re == 1'b0, "wait: re");
        $assert(dout == 1'b1, "wait: dout");

        $finish();
    }
}
