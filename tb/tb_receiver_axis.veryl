#[test(tb_receiver_axis)]
module tb_receiver_axis {
    const CLOCK_FREQUENCY: u32 = 100_000_000;
    const BAUD_RATE      : u32 = 115200;
    const WORD_WIDTH     : u32 = 8;
    const CLOCKS_PER_BIT : u32 = CLOCK_FREQUENCY / BAUD_RATE;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var din             : logic            ;
    var dout_axis_tdata : logic<WORD_WIDTH>;
    var dout_axis_tready: logic            ;
    var dout_axis_tvalid: logic            ;

    inst dut: receiver_axis #(
        CLOCK_FREQUENCY: CLOCK_FREQUENCY,
        BAUD_RATE      : BAUD_RATE      ,
        WORD_WIDTH     : WORD_WIDTH     ,
    ) (
        clk               ,
        rst               ,
        din               ,
        dout_axis_tdata   ,
        dout_axis_tready  ,
        dout_axis_tvalid  ,
    );

    initial {
        din              = 1;
        dout_axis_tready = 1;
        rst.assert      ();

        // state == RECEIVE_BITS
        let frame: logic<WORD_WIDTH + 2> = {1'b1, 8'hA5, 1'b0};
        for j in 0..(WORD_WIDTH + 2) {
            din = frame[j];
            for _i in 0..CLOCKS_PER_BIT {
                clk.next();
                $assert (dout_axis_tvalid == 1'b0, "receive_bits: tvalid");
            }
        }

        clk.next();

        // state == WRITE_WORD
        $assert(dout_axis_tdata == 8'hA5, "write_word: tdata");
        $assert(dout_axis_tvalid == 1'b1, "write_word: tvalid");

        clk.next();

        // state == WAIT
        $assert(dout_axis_tvalid == 1'b0, "wait: tvalid");

        $finish();
    }
}
