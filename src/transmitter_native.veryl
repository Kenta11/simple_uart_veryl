module transmitter_native #(
    param CLOCK_FREQUENCY: u32 = 100_000_000,
    param BAUD_RATE      : u32 = 115200     ,
    param WORD_WIDTH     : u32 = 8          ,
) (
    clk  : input  clock            ,
    rst  : input  reset            ,
    din  : input  logic<WORD_WIDTH>,
    empty: input  logic            ,
    re   : output logic            ,
    dout : output logic            ,
) {
    // constants
    const CLOCKS_PER_BIT: u32 = CLOCK_FREQUENCY / BAUD_RATE;

    // type definition
    enum state_t: logic<2> {
        WAIT,
        ASSERT_READ_ENABLE,
        READ_WORD,
        TRANSMIT_BITS,
    }

    // registers and wires
    var state            : state_t                ;
    var data             : logic  <WORD_WIDTH + 2>;
    var clock_counts     : u32                    ;
    var full_clock_counts: logic                  ;

    // logics
    assign re   = (state == state_t::ASSERT_READ_ENABLE);
    assign dout = if state == state_t::TRANSMIT_BITS ? data[0] : 1;

    always_ff {
        if_reset {
            state = state_t::WAIT;
        } else {
            case state {
                state_t::WAIT              : state = if ~empty ? state_t::ASSERT_READ_ENABLE : state;
                state_t::ASSERT_READ_ENABLE: state = state_t::READ_WORD;
                state_t::READ_WORD         : state = state_t::TRANSMIT_BITS;
                state_t::TRANSMIT_BITS     : state = if full_clock_counts
                    && (data == {{1'b0 repeat (WORD_WIDTH + 1)}, 1'b1}) ?
                    state_t::WAIT
                :
                    state
                ;
            }
        }
    }

    always_ff {
        if_reset {
            data = {1'b1 repeat (WORD_WIDTH + 1)};
        } else {
            case state {
                state_t::READ_WORD    : data = {1'b1, din, 1'b0};
                state_t::TRANSMIT_BITS: data = if full_clock_counts ? {1'b0, data[WORD_WIDTH + 1:1]} : data;
                default               : data = {1'b1 repeat (WORD_WIDTH + 1)};
            }
        }
    }

    always_ff {
        if_reset {
            clock_counts = 0;
        } else {
            case state {
                state_t::TRANSMIT_BITS: clock_counts = if full_clock_counts ? 0 : clock_counts + 1;
                default               : clock_counts = 0;
            }
        }
    }

    assign full_clock_counts = (clock_counts == (CLOCKS_PER_BIT - 1));
}
